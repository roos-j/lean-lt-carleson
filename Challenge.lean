/-- Let $n \geq 1$, let $\alpha \in \mathbb{N}^n$ with $\alpha_i \geq 1$ for all $i$, and let
$\nu_0$ be an integer with $\nu_0 \geq 3 \sum_i \alpha_i + 2$. Then there exists $C > 0$ such that
for every multiplier $m$ in the class $\mathcal{M}^{\nu_0}$ and every Schwartz function $f$ on
$\mathbb{R}^n$,
$$ \|\mathcal{C}_m f\|_{L^{2,\infty}} \leq C \, \|m\|_{\mathcal{M}^{\nu_0}} \, \|f\|_{L^2}. $$ -/
theorem anisotropic_carleson (α : Fin n → ℕ) (hα : ∀ i, 1 ≤ α i) (hn : 0 < n) (ν₀ : ℕ)
    (hν₀ : 3 * (∑ i, α i) + 2 ≤ ν₀) :
      ∃ C : ℝ, 0 < C ∧ ∀ (m : ℝ^n → ℂ), MultiplierClass α ν₀ m → ∀ f : 𝓢(ℝ^n, ℂ),
        weakL2Norm volume (carlesonOperator m f) ≤
          ENNReal.ofReal C * (multiplierNorm α ν₀ m) * eLpNorm f 2 volume := by
  sorry

/-- Let $f : \mathbb{R} \to \mathbb{C}$ be $2\pi$-periodic and square integrable on $[0, 2\pi)$.
Then for almost every $x \in \mathbb{R}$, the partial sums $S_N f(x)$ of the Fourier series of $f$
converge to $f(x)$ as $N \to \infty$. -/
